{
  "name": "flix",
  "description": "Flix Language Server Extension",
  "author": "Flix",
  "license": "Apache-2.0",
  "version": "1.56.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flix/vscode-flix"
  },
  "publisher": "flix",
  "categories": [],
  "icon": "icon.png",
  "keywords": [
    "flix"
  ],
  "engines": {
    "vscode": "^1.82.0",
    "node": "24.x"
  },
  "main": "./client/out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flix.cmdDownload",
        "title": "Flix: Download Latest Version"
      },
      {
        "command": "flix.cmdShowAst",
        "title": "Flix: Show AST"
      },
      {
        "command": "flix.cmdStartRepl",
        "title": "Flix: Start REPL"
      }
    ],
    "languages": [
      {
        "id": "flix",
        "extensions": [
          ".flix"
        ],
        "aliases": [
          "Flix"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon-ext-flix.png",
          "dark": "./icon-ext-flix.png"
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "effect",
        "description": "An effect declaration or reference",
        "superType": "type"
      }
    ],
    "grammars": [],
    "configuration": {
      "type": "object",
      "title": "Flix",
      "properties": {
        "flix.clearOutput.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Continuously clear the output window when changes are made",
          "order": 2
        },
        "flix.extraJvmArgs": {
          "type": "string",
          "default": "",
          "description": "Additional JVM arguments separated by spaces",
          "order": 3
        },
        "flix.extraFlixArgs": {
          "type": "string",
          "default": "",
          "description": "Additional Flix compiler options separated by spaces",
          "order": 4
        }
      }
    },
    "configurationDefaults": {
      "[flix]": {
        "editor.tabSize": 4,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node build.js",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "test": "npm run build && tsc --build ./test && vscode-test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "typecheck": "tsc -b --noEmit",
    "typecheck:client": "tsc -p client --noEmit",
    "typecheck:server": "tsc -p server --noEmit",
    "typecheck:test": "tsc -p test --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.43.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.2",
    "prettier": "^3.3.3",
    "typescript": "^5.0.4"
  }
}
